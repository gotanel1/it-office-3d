      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$PLUGIN_ROOT/scripts/hook.sh\" codex",
            "timeout": 10,
            "commandWindows": "cmd /d /c \"curl.exe -s -m 2 -o NUL --data-binary @- http://127.0.0.1:3737/hook/codex & exit 0\""
