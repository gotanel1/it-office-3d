{
  "name": "claude-code-3d",
  "displayName": "IT-Office-3D",
  "description": "Watch Claude Code work in a cozy 2.5D office with live teammates, task status and activity. Local only, read only.",
  "version": "1.0.2",
  "icon": "media/logo.png",
  "publisher": "gotanel1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gotanel1/it-office-3d"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization"
  ],
  "keywords": [
    "claude",
    "claude code",
    "ai",
    "agent",
    "3d",
    "visualization",
    "office",
    "hooks"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "claudeCode3d",
          "title": "IT-Office-3D",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "claudeCode3d": [
        {
          "type": "webview",
          "id": "claudeCode3d.scene",
          "name": "Office"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeCode3d.open",
        "title": "Open",
        "category": "IT-Office-3D"
      },
      {
        "command": "claudeCode3d.reset",
        "title": "Reset",
        "category": "IT-Office-3D",
        "icon": "$(clear-all)"
      },
      {
        "command": "claudeCode3d.chooseSession",
        "title": "Choose Session",
        "category": "IT-Office-3D",
        "icon": "$(list-selection)"
      },
      {
        "command": "claudeCode3d.diagnostics",
        "title": "Show Diagnostics",
        "category": "IT-Office-3D"
      },
      {
        "command": "claudeCode3d.installPlugin",
        "title": "Install Claude Code Plugin",
        "category": "IT-Office-3D"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "claudeCode3d.chooseSession",
          "when": "view == claudeCode3d.scene",
          "group": "navigation@0"
        },
        {
          "command": "claudeCode3d.reset",
          "when": "view == claudeCode3d.scene",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "IT-Office-3D",
      "properties": {
        "itOffice3d.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "th"
          ],
          "enumDescriptions": [
            "Follow the VS Code display language (Thai when VS Code is in Thai, English otherwise)",
            "English",
            "Thai (ภาษาไทย)"
          ],
          "default": "auto",
          "description": "Language of the office interface and speech bubbles."
        },
        "itOffice3d.notify": {
          "type": "string",
          "enum": [
            "whenUnfocused",
            "always",
            "off"
          ],
          "enumDescriptions": [
            "Only when VS Code is not the active window",
            "Always",
            "Never"
          ],
          "default": "whenUnfocused",
          "description": "Show a notification when Claude finishes a task or waits for your approval."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "getStarted",
        "title": "Get started with IT-Office-3D",
        "description": "Watch Claude Code work as a 3D IT office, in a few steps.",
        "steps": [
          {
            "id": "installPlugin",
            "title": "Install the Claude Code plugin",
            "description": "The plugin reports what Claude does. Without it the office stays still.\n[Install in Terminal](command:claudeCode3d.installPlugin)",
            "media": {
              "markdown": "media/walkthrough/plugin.md"
            },
            "completionEvents": [
              "onCommand:claudeCode3d.installPlugin"
            ]
          },
          {
            "id": "openPanel",
            "title": "Open the office",
            "description": "The office lives in a panel next to Terminal.\n[Open IT-Office-3D](command:claudeCode3d.open)",
            "media": {
              "markdown": "media/walkthrough/open.md"
            },
            "completionEvents": [
              "onCommand:claudeCode3d.open",
              "onView:claudeCode3d.scene"
            ]
          },
          {
            "id": "firstTask",
            "title": "Give Claude a task",
            "description": "Start a new Claude Code chat in this folder and ask for something. Each window follows its own project.\n[Choose Session](command:claudeCode3d.chooseSession)",
            "media": {
              "markdown": "media/walkthrough/task.md"
            }
          },
          {
            "id": "language",
            "title": "Choose the language",
            "description": "Speech bubbles and the wall screen in English or Thai. By default they follow VS Code.\n[Open the setting](command:workbench.action.openSettings?%22itOffice3d.language%22)",
            "media": {
              "markdown": "media/walkthrough/language.md"
            },
            "completionEvents": [
              "onSettingChanged:itOffice3d.language"
            ]
          },
          {
            "id": "help",
            "title": "If nothing moves",
            "description": "Diagnostics show what the extension can see, without prompts or file contents.\n[Show Diagnostics](command:claudeCode3d.diagnostics)",
            "media": {
              "markdown": "media/walkthrough/help.md"
            },
            "completionEvents": [
              "onCommand:claudeCode3d.diagnostics"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "node scripts/copy-core.mjs",
    "package": "npx --yes @vscode/vsce@4.0.0 package --no-dependencies",
    "test": "node --test test/status.test.js"
  }
}
